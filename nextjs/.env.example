# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, used by the reminder cron to read all opt-ins (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (MindShift AI chat) ---
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-6
MINDSHIFT_MODEL=

# --- Twilio (SMS reminders) ---
# Without these set, reminders are simulated (logged to the server console) instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Cron protection ---
# On Vercel, set CRON_SECRET in the project env — Vercel Cron sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=

# --- Feature flags ---
# Off by default. The wellness check-in tracker (/wellness) 404s for everyone while this is unset
# or not exactly "true" — the page, API routes, and any existing checkins data are untouched.
NEXT_PUBLIC_WELLNESS_TRACKER_ENABLED=

# --- Cloudflare R2 (class video hosting) ---
# Account ID: Cloudflare dashboard → R2 → Overview (right sidebar).
R2_ACCOUNT_ID=
# R2 → Manage API Tokens → create a token scoped to Object Read & Write on both buckets below.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private bucket name — holds every paid class video. Never exposed publicly; the app only ever
# hands out short-lived signed URLs for objects in this bucket, and only to signed-in users.
R2_PRIVATE_BUCKET=
# Public bucket's base URL (its r2.dev dev URL, or a custom domain you attach to it) — holds the
# free Grounded Mornings videos plus every class's poster image. Safe to expose to the browser.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
